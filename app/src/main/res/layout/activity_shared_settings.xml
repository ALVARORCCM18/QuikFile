<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black"
    tools:context=".SharedSettingsActivity">

    <!-- Barra de Navegación Superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/blue_app"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnSettingsTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/icon_bg_white"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            app:tint="@color/blue_app" />

        <ImageView
            android:id="@+id/btnHomeTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/icon_bg_white"
            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="@color/blue_app" />

        <ImageView
            android:id="@+id/btnSharedTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/icon_bg_white"
            android:padding="8dp"
            android:src="@drawable/ic_handshake"
            app:tint="@color/blue_app" />

        <ImageView
            android:id="@+id/btnLoginTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@color/icon_bg_white"
            android:padding="8dp"
            android:src="@drawable/ic_group"
            app:tint="@color/blue_app" />
    </LinearLayout>

    <!-- Campo Nombre del Entorno Editable -->
    <LinearLayout
        android:id="@+id/containerEnvName"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/search_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/blue_app" />

        <EditText
            android:id="@+id/etEnvName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Nombre del entorno"
            android:inputType="text"
            android:paddingStart="12dp"
            android:text="\&quot;Entorno compartido\&quot;"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/btnEditEnvName"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/blue_app" />
    </LinearLayout>

    <!-- Iconos de Usuario y Añadir (Alineados a la izquierda y pegados) -->
    <LinearLayout
        android:id="@+id/containerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:gravity="start"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/containerEnvName">

        <!-- Contenedor Usuario -->
        <LinearLayout
            android:id="@+id/btnEnvUsers"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_blue"
                    android:backgroundTint="@color/white" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/cyan_recover" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Usuario"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Contenedor Añadir (Pegado al anterior) -->
        <LinearLayout
            android:id="@+id/btnEnvAddMember"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/circle_cyan" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/cyan_recover" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Añadir"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón Atrás -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="32dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/cyan_recover" />

    <!-- Botones de Acción (Ubicados un poco más arriba del botón de atrás) -->
    <Button
        android:id="@+id/btnDeleteEnv"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="60dp"
        android:backgroundTint="@color/red_delete"
        android:text="Borrar entorno"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnBack" />

    <Button
        android:id="@+id/btnExitEnv"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/cyan_recover"
        android:text="Salir del entorno"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnDeleteEnv" />

</androidx.constraintlayout.widget.ConstraintLayout>