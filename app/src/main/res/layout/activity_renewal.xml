<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black"
    tools:context=".RenewalActivity">

    <!-- Barra de Navegación Superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/cyan_recover"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnSettingsTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/white"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:id="@+id/btnHomeTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/white"
            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:id="@+id/btnSharedTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/white"
            android:padding="8dp"
            android:src="@drawable/ic_handshake"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:id="@+id/btnLoginTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@color/white"
            android:padding="8dp"
            android:src="@drawable/ic_group"
            app:tint="@color/cyan_recover" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="¿Cuánto tiempo desea subscribirse?"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <!-- Opción Indefinidamente -->
        <LinearLayout
            android:id="@+id/optionIndefinite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rbIndefinite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_radio_unselected" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/search_bar_background"
                android:backgroundTint="@color/white"
                android:padding="12dp"
                android:text="Indefinidamente"
                android:textColor="@color/black"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Opción Años -->
        <LinearLayout
            android:id="@+id/optionYears"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rbYears"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_radio_unselected" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/search_bar_background"
                    android:backgroundTint="@color/white"
                    android:padding="12dp"
                    android:text="Durante años"
                    android:textColor="@color/black"
                    android:textSize="18sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etYears"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:layout_marginTop="-4dp"
                android:background="@drawable/payment_field_background"
                android:hint="Introduce el número de años"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/black"
                android:textColorHint="#444444"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Opción Meses -->
        <LinearLayout
            android:id="@+id/optionMonths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rbMonths"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_radio_unselected" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/search_bar_background"
                    android:backgroundTint="@color/white"
                    android:padding="12dp"
                    android:text="Durante meses"
                    android:textColor="@color/black"
                    android:textSize="18sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etMonths"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:layout_marginTop="-4dp"
                android:background="@drawable/payment_field_background"
                android:hint="Introduce el número de meses"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/black"
                android:textColorHint="#444444"
                android:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

    <!-- Navegación Inferior -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginEnd="40dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:id="@+id/btnForward"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/cyan_recover" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>