<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".FileReportActivity">

    <!-- Barra de Navegación Superior (Estandarizada) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/blue_app"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/btnSettingsTop"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:padding="8dp"
                android:src="@drawable/ic_person"
                app:tint="@color/blue_app" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/btnHomeTop"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:padding="8dp"
                android:src="@drawable/ic_home"
                app:tint="@color/blue_app" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/btnSharedTop"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:padding="8dp"
                android:src="@drawable/ic_handshake"
                app:tint="@color/blue_app" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/btnLoginTop"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:padding="8dp"
                android:src="@drawable/ic_group"
                app:tint="@color/blue_app" />
        </FrameLayout>
    </LinearLayout>

    <!-- Encabezado de Reporte -->
    <LinearLayout
        android:id="@+id/reportHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/cancellation_box_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/white_rounded_background"
            android:gravity="center"
            android:padding="12dp"
            android:text="Reportando:"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="&quot;Fichero&quot;"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginEnd="4dp"
            android:src="@android:drawable/stat_sys_warning"
            app:tint="@color/blue_app" />
    </LinearLayout>

    <!-- Motivo del Reporte -->
    <LinearLayout
        android:id="@+id/reasonLabelContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/cancellation_box_border"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/reportHeader">

        <EditText
            android:id="@+id/etReportReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_rounded_background"
            android:padding="12dp"
            android:hint="Introduce el motivo del reporte"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="text" />
    </LinearLayout>

    <!-- Caja de Texto del Reporte -->
    <FrameLayout
        android:id="@+id/reportContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/cancellation_box_border"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintTop_toBottomOf="@id/reasonLabelContainer">

        <EditText
            android:id="@+id/etReportMessage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/white_rounded_background"
            android:gravity="top"
            android:hint="Descripción detallada del reporte..."
            android:textColorHint="@color/blue_app"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:importantForAutofill="no"
            android:inputType="textMultiLine" />
    </FrameLayout>

    <!-- Botones Inferiores -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/blue_app" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSubmitReport"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:backgroundTint="@color/blue_app"
            android:text="REPORTAR"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>