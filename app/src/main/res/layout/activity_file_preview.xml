<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black"
    tools:context=".FilePreviewActivity">

    <!-- Barra de Navegación Superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/blue_app"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnSettingsTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/icon_bg_white"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            app:tint="@color/blue_app" />

        <ImageView
            android:id="@+id/btnHomeTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/icon_bg_white"
            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="@color/blue_app" />

        <ImageView
            android:id="@+id/btnSharedTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/icon_bg_white"
            android:padding="8dp"
            android:src="@drawable/ic_handshake"
            app:tint="@color/blue_app" />

        <ImageView
            android:id="@+id/btnLoginTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@color/icon_bg_white"
            android:padding="8dp"
            android:src="@drawable/ic_group"
            app:tint="@color/blue_app" />
    </LinearLayout>

    <!-- Cabecera de Previsualización -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_file"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/cancellation_box_border"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="Fichero"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/white_rounded_background"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_view"
            app:tint="@color/cyan_recover" />
    </LinearLayout>

    <!-- Contenido del Fichero (Solo Lectura) -->
    <ScrollView
        android:id="@+id/previewScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="@color/cyan_recover"
        android:scrollbarSize="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <TextView
            android:id="@+id/tvFileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este es un texto de prueba extenso para verificar la función de scroll en la previsualización del fichero.\n\nLínea 1: TextoTextoTextoTextoTextoTextoTexto\nLínea 2: TextoTextoTextoTextoTextoTextoTexto\nLínea 3: TextoTextoTextoTextoTextoTextoTexto\nLínea 4: TextoTextoTextoTextoTextoTextoTexto\nLínea 5: TextoTextoTextoTextoTextoTextoTexto\nLínea 6: TextoTextoTextoTextoTextoTextoTexto\nLínea 7: TextoTextoTextoTextoTextoTextoTexto\nLínea 8: TextoTextoTextoTextoTextoTextoTexto\nLínea 9: TextoTextoTextoTextoTextoTextoTexto\nLínea 10: TextoTextoTextoTextoTextoTextoTexto\nLínea 11: TextoTextoTextoTextoTextoTextoTexto\nLínea 12: TextoTextoTextoTextoTextoTextoTexto\nLínea 13: TextoTextoTextoTextoTextoTextoTexto\nLínea 14: TextoTextoTextoTextoTextoTextoTexto\nLínea 15: TextoTextoTextoTextoTextoTextoTexto\nLínea 16: TextoTextoTextoTextoTextoTextoTexto\nLínea 17: TextoTextoTextoTextoTextoTextoTexto\nLínea 18: TextoTextoTextoTextoTextoTextoTexto\nLínea 19: TextoTextoTextoTextoTextoTextoTexto\nLínea 20: TextoTextoTextoTextoTextoTextoTexto\nLínea 21: TextoTextoTextoTextoTextoTextoTexto\nLínea 22: TextoTextoTextoTextoTextoTextoTexto\nLínea 23: TextoTextoTextoTextoTextoTextoTexto\nLínea 24: TextoTextoTextoTextoTextoTextoTexto\nLínea 25: TextoTextoTextoTextoTextoTextoTexto\nLínea 26: TextoTextoTextoTextoTextoTextoTexto\nLínea 27: TextoTextoTextoTextoTextoTextoTexto\nLínea 28: TextoTextoTextoTextoTextoTextoTexto\nLínea 29: TextoTextoTextoTextoTextoTextoTexto\nLínea 30: TextoTextoTextoTextoTextoTextoTexto\nLínea 31: TextoTextoTextoTextoTextoTextoTexto\nLínea 32: TextoTextoTextoTextoTextoTextoTexto\nLínea 33: TextoTextoTextoTextoTextoTextoTexto\nLínea 34: TextoTextoTextoTextoTextoTextoTexto\nLínea 35: TextoTextoTextoTextoTextoTextoTexto\nLínea 36: TextoTextoTextoTextoTextoTextoTexto\nLínea 37: TextoTextoTextoTextoTextoTextoTexto\nLínea 38: TextoTextoTextoTextoTextoTextoTexto\nLínea 39: TextoTextoTextoTextoTextoTextoTexto\nLínea 40: Fin del documento de prueba."
            android:textColor="@color/white"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <!-- Botones Inferiores -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:id="@+id/btnHistory"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/circle_cyan"
            android:padding="20dp"
            android:src="@android:drawable/ic_menu_recent_history"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/white" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>