<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black"
    tools:context=".SubscriptionSuccessActivity">

    <!-- Barra de Navegación Superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/cyan_recover"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnSettingsTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/white"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:id="@+id/btnHomeTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/white"
            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:id="@+id/btnSharedTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:background="@color/white"
            android:padding="8dp"
            android:src="@drawable/ic_handshake"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:id="@+id/btnLoginTop"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@color/white"
            android:padding="8dp"
            android:src="@drawable/ic_group"
            app:tint="@color/cyan_recover" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGracias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="GRACIAS"
        android:textColor="@color/white"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <TextView
        android:id="@+id/tvSubGracias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="POR CONFIAR EN NOSOTROS"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGracias" />

    <!-- Icono Perfil con Corona -->
    <FrameLayout
        android:id="@+id/profileContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubGracias">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="bottom|center_horizontal"
            android:src="@drawable/ic_person"
            app:tint="@color/cyan_recover" />

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="top|center_horizontal"
            android:src="@drawable/ic_crown"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Caja Blanca Usuario -->
    <TextView
        android:id="@+id/tvUserNameDisplay"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/search_bar_background"
        android:backgroundTint="@color/white"
        android:gravity="center"
        android:padding="12dp"
        android:text="Usuario"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileContainer" />

    <TextView
        android:id="@+id/tvSuccessMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Ahora eres un cliente premium"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUserNameDisplay" />

    <!-- Botón Atrás (al Main) -->
    <ImageView
        android:id="@+id/btnBackToMain"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="32dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/cyan_recover" />

</androidx.constraintlayout.widget.ConstraintLayout>